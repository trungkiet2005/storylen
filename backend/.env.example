# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=StoryLens API
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Storage Buckets ─────────────────────────────────────────────────
SUPABASE_BUCKET_ORIGINALS=manga-originals
SUPABASE_BUCKET_THUMBNAILS=manga-thumbnails

# ─── Gemini (Google AI Studio) ────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here,your-gemini-api-key-2-here # Hỗ trợ nhiều key cách nhau bằng dấu phẩy để chống hết Quota
GEMINI_MODEL=gemini-1.5-flash

# ─── HuggingFace Space (AI Worker) ───────────────────────────────────────────
# Create your Space at: https://huggingface.co/spaces → New Space → Docker
# Upload contents of ai_service/ folder to the Space repo
# Set GEMINI_API_KEY secret in: Space Settings → Repository secrets
HF_SPACE_URL=https://your-username-storylens-ai-worker.hf.space
HF_SPACE_TOKEN=                           # leave empty if Space is public

# ─── Upload ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
