# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=StoryLens API
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Storage Buckets ─────────────────────────────────────────────────
SUPABASE_BUCKET_ORIGINALS=manga-originals
SUPABASE_BUCKET_THUMBNAILS=manga-thumbnails

# Auth cookies
# Local HTTP dev: secure=false, samesite=lax
# Cross-domain HTTPS production: secure=true, samesite=none
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ─── Gemini (Google AI Studio) ────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here,your-gemini-api-key-2-here # Hỗ trợ nhiều key cách nhau bằng dấu phẩy để chống hết Quota
GEMINI_MODEL=gemini-2.5-flash

# ─── HuggingFace Space (AI Worker) ───────────────────────────────────────────
# Create your Space at: https://huggingface.co/spaces → New Space → Docker
# Set GEMINI_API_KEY secret in: Space Settings → Repository secrets
HF_SPACE_URL=http://localhost:7860
HF_SPACE_TOKEN=                           # leave empty if Space is public

# ai_module (Image Translation Worker)
# Local: python -m ai_module.main --host 127.0.0.1 --port 8001
AI_MODULE_URL=http://localhost:8001
AI_MODULE_TOKEN=
#
# Knobs below are read by ai_module itself (not backend). Set them in
# the ai_module deploy env (HF Space Secrets or Kaggle env), not here:
#   AI_MODULE_WORKERS=2          # spawn N shared subprocesses; 0=auto (=GPU count)
#   AI_MODULE_ALLOWED_ORIGINS=   # comma-separated CORS allowlist; empty = closed
#   RESULT_TTL_HOURS=6           # auto-purge result/ folders older than this
#   RESULT_CLEANUP_INTERVAL_MIN=30
#   SHARED_LOG_DIR=              # override per-worker log dir (default: result/)
AI_MODULE_TRANSLATOR=gemini
AI_MODULE_TARGET_LANG=VIN
AI_MODULE_DETECTOR=manga_yolo
AI_MODULE_OCR=mocr
AI_MODULE_INPAINTER=lama_large
# manga2eng_pillow scales font to fit bubble (HarfBuzz shaping → Vietnamese diacritics OK).
# Switch back to "default" only if you need vertical CJK rendering.
AI_MODULE_RENDERER=manga2eng_pillow

# Detector tuning (manga_yolo). Lower thresholds → catches more bubbles, more furigana / SFX.
AI_MODULE_DETECTOR_BOX_THRESHOLD=0.4
AI_MODULE_DETECTOR_TEXT_THRESHOLD=0.3
AI_MODULE_DETECTOR_UNCLIP_RATIO=2.6
AI_MODULE_DETECTION_SIZE=1536

# Inpainter tuning. Smaller size → much faster (LaMa is O(N²)). 1280 keeps quality.
# Drop to 1024 if you keep hitting Cloudflare 524 timeouts on HF Spaces.
AI_MODULE_INPAINTING_SIZE=1280
AI_MODULE_INPAINTING_PRECISION=bf16

# Renderer text-fit knobs. Negative offset shrinks every bubble. Minimum prevents text → 0.
AI_MODULE_FONT_SIZE_OFFSET=0
AI_MODULE_FONT_SIZE_MINIMUM=10
AI_MODULE_DISABLE_FONT_BORDER=false

# ─── Narration / Listen mode (VLM + TTS) ─────────────────────────────────────
# VLM = vision LLM served on a GPU pod behind an ollama-compatible endpoint.
# Local: point at your own ollama (ollama pull qwen2.5vl:7b). Pod: expose ollama
# via a Cloudflare quick-tunnel and paste the URL here, OR override at runtime in
# the DB (app_settings: vlm_provider="tunnel", vlm_tunnel_url="https://…").
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen2.5vl:7b                    # direct responder; qwen3-vl:8b also works (slower, thinks)
VLM_TOKEN=                                # Bearer token if the tunnel is protected
# VLM_MAX_TOKENS=512
# VLM_TEMPERATURE=0.6

# Text-to-speech engine: edge (Microsoft neural, no key) | pyttsx3 (offline) | coqui (XTTS on pod)
TTS_DEFAULT_ENGINE=edge
TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural
# TTS_DEFAULT_RATE=+0%
# COQUI_TTS_URL=                          # https://<tunnel> — enables the XTTS engine when set
NARRATION_BUCKET=manga-audio              # create this (private) Supabase Storage bucket
# NARRATION_CREDIT_COST=1
# NARRATION_ENABLED=true

# ─── Upload ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── Account self-service ────────────────────────────────────────────────────
# Where Supabase Auth sends the user after they click the password-reset email.
# Must match your deployed frontend URL.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password
FRONTEND_BASE_URL=http://localhost:3000

# ─── Forum rate limits (optional — override defaults) ────────────────────────
# Defaults are sensible for free-tier; only set these to override.
# RATE_LIMIT_FORUM_THREAD=5/minute
# RATE_LIMIT_FORUM_REPLY=20/minute
# RATE_LIMIT_FORUM_VOTE=60/minute

# ─── Stripe (optional — payment integration) ─────────────────────────────────
# Leave empty to keep checkout disabled. Set these to enable /credits/checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
