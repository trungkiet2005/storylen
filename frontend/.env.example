# Backend API base (must end with /v1)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/v1

# Supabase public credentials — used only on the /reset-password page to call
# Supabase Auth directly with the recovery token from the email link.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public origin of the frontend (used to build share links shown to users).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
