# =============================================================================
# StoryLens Demo — Environment Variables
# Keys are in secrets/keys.json, NOT here.
# Copy this to .env and adjust as needed.
# =============================================================================

# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=*

# Gemini models (Google AI Studio)
# API key → secrets/keys.json  (field: "gemini_api_key")
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash
GEMINI_CRITIC_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Admin seed (optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Database (SQLite for local dev; swap to postgresql+asyncpg://... for prod)
DB_URL=sqlite+aiosqlite:///./storylens.db

# Storage
ARTIFACT_DIR=./artifacts
VECTOR_DB_DIR=./chromadb
MAX_UPLOAD_MB=30

# External ngrok image worker (optional)
# API key → secrets/keys.json  (field: "kaggle_worker_api_key")
# The worker must expose POST /translate-image, like storylens_kaggle_build.
KAGGLE_WORKER_URL=
